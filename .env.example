# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser). Reserved for future client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/orders and the order-confirmation page to talk to
# Supabase with full privileges. MUST NOT reach the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
