# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
#
# Two projects, same migrations (see SUPABASE_PLAN.md):
#   funda1959-test        -> local development (.env.local) + Vercel Preview
#   funda1959-production  -> Vercel Production only
# Local development always uses the TEST project. Each project carries a
# marker row (public.app_environment); the app refuses every Supabase request
# — reads and writes — when the connected project's marker is missing or
# doesn't match (local/Preview = test, Production = production), so test
# deployments can neither read nor write production data.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser). Not used yet — leave empty unless
# browser-side Supabase Auth is introduced later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Every database read/write goes through these (orders,
# campaigns, branch stock). MUST NOT reach the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin login — demo-grade auth (env credentials + a signed session cookie).
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_. Never commit
# real values — this file only documents the variable names.
#
# One fixed account per branch, plus one central (SUPER_ADMIN) account.
# Before production, replace this whole layer with Supabase Auth (or
# another real identity provider) — see src/lib/admin/session.ts.
# ---------------------------------------------------------------------------
ADMIN_GOP_USERNAME=
ADMIN_GOP_PASSWORD=

ADMIN_PANORA_USERNAME=
ADMIN_PANORA_PASSWORD=

ADMIN_INCEK_USERNAME=
ADMIN_INCEK_PASSWORD=

MERKEZ_ADMIN_USERNAME=
MERKEZ_ADMIN_PASSWORD=

# Secret used to HMAC-sign the admin session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=
